#!/usr/bin/env php
<?php

declare(strict_types=1);

use Golovanov\AlertLoop\Cli;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

if (!class_exists(Cli::class)) {
    fwrite(STDERR, "alertloop: cannot load the library; run composer install first\n");
    exit(1);
}

exit(Cli::main(array_values($argv), STDOUT, STDERR));
